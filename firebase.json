{
  "hosting": {
    "public": "nodebackend/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "thinkorix-backend",
          "region": "asia-south1"
        }
      },
      {
        "source": "/storage/**",
        "run": {
          "serviceId": "thinkorix-backend",
          "region": "asia-south1"
        }
      }
    ]
  }
}
